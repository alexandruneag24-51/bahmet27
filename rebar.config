%% Bahmet 27 -- configurare rebar3.
{erl_opts, [debug_info]}.

{deps, []}.

%% Biblioteci native: se construiesc cu ./build.sh, care le aseaza in priv/.
%% Ruleaza ./check.sh ca sa faci build si sa treci intreaga suita dintr-o data.

{shell, [{apps, [bahmet]}]}.

%% Common Test. Suitele traiesc in test/ si sunt compilate automat.
{ct_opts, [
    {verbose, true},
    %% Un caz care nu s-a terminat in 60s e blocat, nu lent.
    {ct_hooks, []}
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.
{cover_excl_mods, [bahmet_smoke]}.

{dialyzer, [
    {warnings, [unmatched_returns, error_handling, unknown]}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        %% Rabdarea coborata NU se pune aici: `silence_releases' o schimba
        %% explicit si o pune la loc. Un test care depinde de configuratia
        %% globala a profilului ascunde de ce trece.
        {extra_src_dirs, [{"test", [{recursive, true}]}]}
    ]}
]}.
