# hearth.b27 -- cercul mic, dar întreg.
#
# Perechea lui contemplation.b27: aceleași trăsături, mai puține construcții.
# Nu are `ask`, nu are `await` — dar are tot ce trebuie ca o ființă să poată
# veni la viață, fiindcă altfel compilatorul o refuză.

circle Hearth

  ground deep
    dimension 256
    seed      27
  end

  commons wisdom : tensor[256]

  being Keeper

    carries
      question  : text
      insight   : tensor[256] = void
      offerings : count       = 0
    end

    patience 30s
    grace     5s

    awaken with (q : text) ->
      question <- q
      keep
    end

    upon offering(gift : tensor[256]) from giver ->
      insight   <- intuit deep with gift
      offerings <- offerings + 1
      offer thanks(offerings) to giver
      keep
    end

    upon calling_home ->
      completion merging insight into wisdom
    end

    upon silence ->
      release quietly giving insight
    end

    when broken ->
      release withholding insight
    end

  end

  # Fără adunare, `Keeper` ar fi cod pentru cineva care nu se poate întâmpla.
  # Compilatorul spune asta acum, nu peste șase luni.
  gathering Circle
    harmony     one_for_one
    forbearance 5 within 60s
    completes when all present are complete
  end

  communion Home
    harmony     rest_for_one
    forbearance 3 within 60s

    tend deep   always
    tend wisdom always
    tend Circle while_needed
  end

  rite kindle(questions : list of text) ->
    for each q in questions ->
      let one = birth Keeper into Circle with (q)
      offer offering(tensor.origin(256)) to one
    end
    answer wisdom
  end

end
