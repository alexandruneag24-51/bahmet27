# ═══════════════════════════════════════════════════════════════════════
#  contemplation.b27  —  Bahmet 27, cercul complet
#
#  Un cerc de ființe primește o întrebare, coboară în Adânc după intuiție,
#  și se împlinește dăruindu-și înțelegerea bunului comun.
#
#  Fiecare construct de aici compilează. Vezi dsl/GRAMMAR.md, tabelul de
#  coborâre — și modulele generate, care sunt dovada lui.
# ═══════════════════════════════════════════════════════════════════════

circle Council.Dawn

  # ── TEMELIA ──────────────────────────────────────────────────────────
  # Se deschide o singură dată, ÎNAINTEA oricărei ființe: nimeni nu se naște
  # pe un pământ care nu există încă. Ordinea nu e stilistică — devine ordinea
  # copiilor într-un arbore `rest_for_one`, unde dependența e structurală.
  ground deep
    dimension 256
    seed      27
  end

  # ── BUNUL COMUN ──────────────────────────────────────────────────────
  # Nu e memorie partajată: e o ființă ca oricare alta, care primește daruri
  # prin mesaje. Nimeni nu scrie în ea; toți îi oferă.
  commons wisdom : tensor[256]

  # ── FIINȚA ───────────────────────────────────────────────────────────
  # Nu împarte nimic. Ce vede `carries` îi aparține exclusiv și piere odată
  # cu ea — dacă nu alege să dăruiască.
  being Contemplator

    carries
      question  : text
      insight   : tensor[256] = void
      offerings : count       = 0
    end

    # Răbdarea e declarată, mărginită, vizibilă. O ființă care ar aștepta la
    # nesfârșit nu e răbdătoare — e blocată.
    patience 30s
    grace     5s

    awaken with (q : text) ->
      question <- q
      keep
    end

    # `upon` e cutia poștală. Mesajul e un dar, nu o comandă: emițătorul nu
    # se blochează. `intuit` traversează puntea în Adânc, pe planificator
    # murdar — calculul greu se retrage politicos din firul comun.
    upon offering(seed : tensor[256]) from giver ->
      insight   <- intuit deep with seed
      offerings <- offerings + 1
      offer thanks(offerings) to giver
      keep
    end

    # Singura formă sincronă, și are OBLIGATORIU o limită. Nu ceri nimănui
    # timp nedefinit — iar gramatica nu are producție pentru o cerere fără
    # `within`, deci nici nu poți încerca.
    ask reflection within 1s ->
      answer reflect deep
    end

    # `completion` nu e moarte, e sfârșitul unui drum dus până la capăt.
    upon calling_home ->
      completion merging insight into wisdom
    end

    # Răbdarea s-a epuizat: eliberează locul, fără să se plângă.
    upon silence ->
      release quietly giving insight
    end

    # Ceva s-a frânt înăuntru. NU dăruiește: o stare pe jumătate scrisă ar
    # otrăvi fiecare intuiție viitoare a fiecărei ființe.
    when broken ->
      release withholding insight
    end

  end

  # ── COMUNIUNEA ───────────────────────────────────────────────────────
  # Cine ține de cine. Ordinea `tend` ESTE graful de dependență: dacă temelia
  # se schimbă, tot ce s-a ridicat după ea se refondează — dar nimic dinaintea
  # ei nu e tulburat.
  communion Council
    harmony     rest_for_one
    forbearance 3 within 60s

    tend deep      always
    tend wisdom    always
    tend Gathering while_needed
  end

  # ── ADUNAREA ─────────────────────────────────────────────────────────
  # Căderea uneia nu atinge pe nimeni: fiecare e singură în fața propriei
  # greșeli, dar niciodată singură în cerc. Iar când toate s-au împlinit, se
  # împlinește și adunarea — fără ca cineva să numere.
  gathering Gathering
    harmony     one_for_one
    forbearance 5 within 60s
    completes when all present are complete
  end

  # ── RITUL ────────────────────────────────────────────────────────────
  rite convene(questions : list of text) ->
    let seed = intuit deep with tensor.origin(256)

    for each q in questions ->
      let one = birth Contemplator into Gathering with (q)
      offer offering(seed) to one
    end

    for each one in Gathering.present ->
      offer calling_home to one
    end

    await Gathering completion within 2m

    answer wisdom
  end

end
